# ==============================================================================
# AeroBook — Production & Vercel Preview Environment Variables
# All external services gracefully fall back to built-in mocks when unconfigured.
# ==============================================================================

# --- Flight Provider Configuration ---
# Options: "mock" (default, zero-latency deterministic generator) | "amadeus" | "duffel"
FLIGHT_PROVIDER=mock

# Live Provider Credentials (required if FLIGHT_PROVIDER=amadeus or duffel)
PROVIDER_API_KEY=
PROVIDER_API_SECRET=

# --- Upstash Redis (Distributed Cache & Rate Limiting) ---
# If omitted, AeroBook uses an in-memory TTL LRU cache and memory rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Neon Postgres & Drizzle ORM (Database Layer) ---
# Connection string to Neon serverless database.
# If omitted, AeroBook runs on an in-memory seed database with full session persistence.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Auth.js (NextAuth v5 Beta) Authentication ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=aerobook-super-secret-production-encryption-key-32chars

# Google OAuth 2.0 Credentials (Optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auto-configured for Vercel preview deployments (auto-resolves from VERCEL_URL)
AUTH_URL=https://aerobook.flights
AUTH_TRUST_HOST=true

# --- Sentry Error Monitoring ---
# Project DSN for error capture and performance telemetry
SENTRY_DSN=
# Optional build-time token for source map uploads
SENTRY_AUTH_TOKEN=

# --- Canonical Public Site URL ---
# On Vercel, automatically falls back to https://${VERCEL_URL} in preview deployments
NEXT_PUBLIC_SITE_URL=https://aerobook.flights
