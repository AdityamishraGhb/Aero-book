# ==============================================================================
# AeroBook — Environment Configuration
# All external integrations are optional for local development.
# The app boots and functions in complete mock mode with zero variables defined.
# ==============================================================================

# Flight Provider adapter selection (mock | amadeus | duffel)
# Defaults to "mock" using local dataset and deterministic generator.
FLIGHT_PROVIDER=mock

# Live Provider Credentials (used in Phase 7+ when FLIGHT_PROVIDER != mock)
PROVIDER_API_KEY=
PROVIDER_API_SECRET=

# Redis Cache & Rate Limiting via Upstash (Optional)
# If omitted, AeroBook uses an in-memory cache and disables API rate limits in dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon PostgreSQL & Auth.js (Optional, Phase 8+)
# If omitted, authentication and persisted user accounts remain gracefully hidden.
DATABASE_URL=
AUTH_SECRET=

# Sentry Error Monitoring (Optional)
# If omitted, Sentry telemetry is disabled.
SENTRY_DSN=

# Canonical deployment or local URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
